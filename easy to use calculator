import tkinter as tk
from tkinter import messagebox

class CalculatorWithUndo:
    def __init__(self, root):
        self.root = root
        self.root.title("Calculator ᯓ★")
        self.root.geometry("450x450")
        self.root.configure(bg="#EEC8CB")  

        self.history_stack = []

        self.entry = tk.Entry(root, width=25, font=("Times New Roman", 14), bg="#fff0f5", fg="#333")
        self.entry.pack(pady=15)

        btn_frame = tk.Frame(root, bg="#EEC8CB")
        btn_frame.pack()

        button_style = {
            "font": ("Times New Roman", 12, "bold"),
            "bg": "#CE8A97",  
            "fg": "white",
            "activebackground": "#CE8A97",
            "activeforeground": "black",
            "width": 10,
            "height": 2
        }

        tk.Button(btn_frame, text="Calculate", command=self.calculate, **button_style).grid(row=0, column=0, padx=5, pady=5)
        tk.Button(btn_frame, text="Undo", command=self.undo, **button_style).grid(row=0, column=1, padx=5, pady=5)
        tk.Button(btn_frame, text="Peek", command=self.peek, **button_style).grid(row=0, column=2, padx=5, pady=5)
        tk.Button(btn_frame, text="Count", command=self.count, **button_style).grid(row=1, column=0, padx=5, pady=5)
        tk.Button(btn_frame, text="History", command=self.show_history, **button_style).grid(row=1, column=1, padx=5, pady=5)
        tk.Button(btn_frame, text="Exit", command=root.quit, **button_style).grid(row=1, column=2, padx=5, pady=5)

        self.result_label = tk.Label(root, text="⋆˚✿˖° Result: ", font=("Times New Roman", 14, "bold"), bg="#EEC8CB", fg="#333")
        self.result_label.pack(pady=15)

    def calculate(self):
        expression = self.entry.get()
        try:
            result = eval(expression)  
            self.result_label.config(text=f"⋆˚✿˖° Result: {result}")
            self.history_stack.append((expression, result))
            self.entry.delete(0, tk.END)
        except Exception as e:
            messagebox.showerror("Error", f"Invalid Expression :(")

    def undo(self):
        if self.history_stack:
            last_expr, last_result = self.history_stack.pop()
            messagebox.showinfo("Undo", f"Removed: {last_expr} = {last_result}")
            if self.history_stack:
                expr, res = self.history_stack[-1]
                self.result_label.config(text=f"⋆˚✿˖° Result: {res}")
            else:
                self.result_label.config(text="⋆˚✿˖° Result: ")
        else:
            messagebox.showwarning("Undo", "No history to undo :(")

    def peek(self):
        if self.history_stack:
            expr, res = self.history_stack[-1]
            messagebox.showinfo("Peek", f"Latest: {expr} = {res}")
        else:
            messagebox.showinfo("Peek", "Stack is empty :(")

    def count(self):
        total = len(self.history_stack)
        messagebox.showinfo("Count", f"Total operations: {total}")

    def show_history(self):
        if self.history_stack:
            history_text = "\n".join([f"{expr} = {res}" for expr, res in self.history_stack])
            messagebox.showinfo("History", history_text)
        else:
            messagebox.showinfo("History", "No calculations yet :(")

if __name__ == "__main__":
    root = tk.Tk()
    app = CalculatorWithUndo(root)
    root.mainloop()
